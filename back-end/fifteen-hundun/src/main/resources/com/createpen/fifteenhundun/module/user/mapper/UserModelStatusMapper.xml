<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.createpen.fifteenhundun.module.user.mapper.UserModelStatusMapper">
    <update id="updateUserModelStatus">
        UPDATE user_model_status
        <set>
            <if test="health != null">
                health = #{health},
            </if>
            <if test="finance != null">
                finance = #{finance},
            </if>
            <if test="knowledge != null">
                knowledge = #{knowledge},
            </if>
            <if test="memo != null">
                memo = #{memo},
            </if>
        </set>
        WHERE user_id = #{userId}
    </update>
</mapper>